# Postgres
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=causegraph
POSTGRES_USER=causegraph
POSTGRES_PASSWORD=causegraph
DATABASE_URL=postgresql+psycopg://causegraph:causegraph@postgres:5432/causegraph

# Redis
REDIS_URL=redis://redis:6379/0

# Kafka
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_INTERACTION_TOPIC=interaction-events

# OpenTelemetry
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_SERVICE_NAMESPACE=causegraph

# Service URLs (used by downstream callers and the benchmark harness)
EVENT_API_URL=http://event-api:8001
FEATURE_WORKER_URL=http://feature-worker:8002
MODEL_SERVICE_URL=http://model-service:8003
RANKING_API_URL=http://ranking-api:8004
QUALITY_MONITOR_URL=http://quality-monitor:8005
CAUSEGRAPH_API_URL=http://causegraph-api:8000

# Prometheus (queried by the anomaly engine)
PROMETHEUS_URL=http://prometheus:9090

# Workload / benchmark
WORKLOAD_SEED=42

# Causal validation (spec section 5.3). Off by default: mutates live fault
# state mid-run and only applies to method=causegraph. Benchmark/dev only --
# never exposed over the causegraph-api HTTP surface.
ALLOW_INTERVENTION_TESTS=0
INTERVENTION_RECOVERY_SECONDS=10.0

# Investigator agent synthesis (spec section 6/8). Off by default; purely
# additive when on -- never changes the ranked Hypothesis list.
ENABLE_AGENT_SYNTHESIS=0

# LLM adapter (causegraph/llm/provider.py). "mock" needs no API key and is
# the default; set to "anthropic" + ANTHROPIC_API_KEY to use a real model.
CAUSEGRAPH_LLM_PROVIDER=mock
# CAUSEGRAPH_LLM_MODEL=claude-haiku-4-5-20251001
# ANTHROPIC_API_KEY=
